{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solarloss:review:0.1.0",
  "title": "SolarLoss review artifact",
  "description": "Provisional v0.1 handoff contract. Scientific field semantics remain subject to review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "analysis_version",
    "produced_at",
    "dataset",
    "experiment",
    "series",
    "metrics",
    "baseline_comparison",
    "uncertainty",
    "quality_checks",
    "exclusions",
    "decision",
    "limitations",
    "robustness",
    "placebo"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "review_id": {
      "type": "string",
      "pattern": "^review_[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
    },
    "analysis_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "produced_at": { "type": "string", "format": "date-time" },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source", "version", "checksums"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "format": "uri" },
        "version": { "type": "string", "minLength": 1 },
        "extraction_date": { "type": "string", "format": "date" },
        "checksums": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/checksum" }
        }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "type",
        "experimental_system",
        "reference_system",
        "time_window",
        "label_provenance"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"
        },
        "type": { "type": "string", "minLength": 1 },
        "experimental_system": { "$ref": "#/$defs/system" },
        "reference_system": { "$ref": "#/$defs/system" },
        "time_window": { "$ref": "#/$defs/timeWindow" },
        "label_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "method", "label"],
          "properties": {
            "source": { "type": "string", "minLength": 1 },
            "method": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "reference": { "type": "string" }
          }
        }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp_basis", "power_unit", "samples"],
      "properties": {
        "timestamp_basis": { "const": "UTC" },
        "power_unit": { "type": "string", "minLength": 1 },
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sample" }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "energy_deficit",
        "deficit_fraction",
        "coverage",
        "calibration_error",
        "valid_interval_count",
        "total_interval_count"
      ],
      "properties": {
        "energy_deficit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "unit", "calculation"],
          "properties": {
            "value": { "type": "number" },
            "unit": { "type": "string", "minLength": 1 },
            "calculation": { "type": "string", "minLength": 1 }
          }
        },
        "deficit_fraction": { "$ref": "#/$defs/ratioMetric" },
        "coverage": { "$ref": "#/$defs/ratioMetric" },
        "calibration_error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit",
            "statistic",
            "evaluation_population",
            "denominator"
          ],
          "properties": {
            "value": { "type": "number" },
            "unit": { "type": "string", "minLength": 1 },
            "statistic": { "type": "string", "minLength": 1 },
            "evaluation_population": { "const": "held_out_healthy" },
            "numerator": { "$ref": "#/$defs/quantity" },
            "denominator": { "$ref": "#/$defs/quantity" }
          }
        },
        "valid_interval_count": { "type": "integer", "minimum": 0 },
        "total_interval_count": { "type": "integer", "minimum": 1 }
      }
    },
    "baseline_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "unit",
        "evaluation_population",
        "simple_baseline",
        "calibrated_reference"
      ],
      "properties": {
        "metric": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1 },
        "evaluation_population": { "type": "string", "minLength": 1 },
        "simple_baseline": { "$ref": "#/$defs/comparisonValue" },
        "calibrated_reference": { "$ref": "#/$defs/comparisonValue" },
        "reported_difference": { "$ref": "#/$defs/quantity" },
        "calculation": { "type": "string" }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "independent_blocks", "exploratory", "limitations"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "independent_blocks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "unit"],
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "unit": { "type": "string", "minLength": 1 }
          }
        },
        "interval": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["level", "lower", "upper", "unit"],
          "properties": {
            "level": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
            "lower": { "type": "number" },
            "upper": { "type": "number" },
            "unit": { "type": "string", "minLength": 1 }
          }
        },
        "not_estimated_reason": { "type": "string" },
        "exploratory": { "type": "boolean" },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "quality_checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["start", "end", "reason"],
        "properties": {
          "start": { "type": "string", "format": "date-time" },
          "end": { "type": "string", "format": "date-time" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reasons", "rules_version"],
      "properties": {
        "state": {
          "enum": ["supported_change", "inconclusive", "insufficient_evidence"]
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "rules_version": { "type": "string", "minLength": 1 }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "robustness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "findings"],
      "properties": {
        "status": { "enum": ["evaluated", "not_evaluated"] },
        "findings": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/finding" },
              {
                "type": "object",
                "required": ["synthetic"],
                "properties": {
                  "synthetic": { "type": "boolean" }
                }
              }
            ]
          }
        }
      }
    },
    "placebo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "findings"],
      "properties": {
        "status": { "enum": ["evaluated", "not_evaluated"] },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        }
      }
    }
  },
  "$defs": {
    "checksum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest", "scope"],
      "properties": {
        "algorithm": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "description"],
      "properties": {
        "identifier": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "timeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date-time" },
        "end": { "type": "string", "format": "date-time" }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp",
        "measured_power",
        "raw_reference_power",
        "expected_power",
        "valid"
      ],
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "measured_power": { "type": ["number", "null"] },
        "raw_reference_power": { "type": ["number", "null"] },
        "expected_power": { "type": ["number", "null"] },
        "valid": { "type": "boolean" },
        "expected_lower_bound": { "type": "number" },
        "expected_upper_bound": { "type": "number" }
      },
      "dependentRequired": {
        "expected_lower_bound": ["expected_upper_bound"],
        "expected_upper_bound": ["expected_lower_bound"]
      },
      "if": { "properties": { "valid": { "const": true } } },
      "then": {
        "properties": {
          "measured_power": { "type": "number" },
          "raw_reference_power": { "type": "number" },
          "expected_power": { "type": "number" }
        }
      }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "ratioMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "numerator", "denominator"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 },
        "numerator": { "$ref": "#/$defs/quantity" },
        "denominator": { "$ref": "#/$defs/quantity" },
        "calculation": { "type": "string" }
      }
    },
    "comparisonValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "number" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "detail"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed", "not_evaluated", "reported"] },
        "detail": { "type": "string", "minLength": 1 },
        "result": { "type": "string" },
        "synthetic": { "type": "boolean" }
      }
    }
  }
}
